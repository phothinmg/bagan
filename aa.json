    "fileName": "minima",
    "slug": "/minima.css",
    "raw": "/* 1. Base Resets & Variables */\n:root {\n  --primary-color: #222222;\n  --secondary-color: #555555;\n  --accent-color: #0066cc;\n  --bg-color: #fcfcfc;\n  --card-bg: #ffffff;\n  --border-color: #eaeaea;\n  --font-stack:\n    -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial,\n    sans-serif;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: var(--font-stack);\n  background-color: var(--bg-color);\n  color: var(--primary-color);\n  line-height: 1.6;\n  font-size: 16px;\n}\n\na {\n  color: var(--accent-color);\n  text-decoration: none;\n}\n\na:hover {\n  text-decoration: underline;\n}\n\n.container {\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 0 20px;\n}\n\n/* 2. Header & Navigation */\n.blog-header {\n  background-color: var(--card-bg);\n  padding: 40px 0 20px 0;\n  text-align: center;\n}\n\n.blog-title {\n  font-size: 2.5rem;\n  font-weight: 700;\n  letter-spacing: -1px;\n}\n\n.blog-tagline {\n  color: var(--secondary-color);\n  margin-top: 5px;\n  font-size: 1.1rem;\n}\n\n.blog-nav {\n  background-color: var(--card-bg);\n  border-top: 1px solid var(--border-color);\n  border-bottom: 1px solid var(--border-color);\n  padding: 12px 0;\n  position: sticky;\n  top: 0;\n  z-index: 100;\n}\n\n.blog-nav a {\n  color: var(--primary-color);\n  font-weight: 500;\n  margin-right: 20px;\n}\n\n.blog-nav a:hover {\n  color: var(--accent-color);\n  text-decoration: none;\n}\n\n/* 3. Main Two-Column Layout */\n.main-layout {\n  display: grid;\n  grid-template-columns: 2fr 1fr;\n  gap: 40px;\n  margin-top: 40px;\n  margin-bottom: 60px;\n}\n\n/* 4. Blog Posts Feed */\n.blog-main {\n  display: flex;\n  flex-direction: column;\n  gap: 40px;\n}\n\n.blog-post {\n  background-color: var(--card-bg);\n  padding: 30px;\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n}\n\n.post-meta {\n  font-size: 0.85rem;\n  color: var(--secondary-color);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.post-title {\n  margin: 10px 0 15px 0;\n  font-size: 1.75rem;\n  line-height: 1.3;\n}\n\n.post-title a {\n  color: var(--primary-color);\n}\n\n.post-title a:hover {\n  color: var(--accent-color);\n  text-decoration: none;\n}\n\n.post-excerpt {\n  color: #444444;\n  margin-bottom: 20px;\n}\n\n.read-more {\n  font-weight: 600;\n}\n\n/* 5. Sidebar Widgets */\n.blog-sidebar {\n  display: flex;\n  flex-direction: column;\n  gap: 30px;\n}\n\n.sidebar-widget {\n  background-color: var(--card-bg);\n  padding: 24px;\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n}\n\n.sidebar-widget h3 {\n  margin-bottom: 15px;\n  font-size: 1.2rem;\n  border-bottom: 2px solid var(--primary-color);\n  padding-bottom: 5px;\n  display: inline-block;\n}\n\n.sidebar-widget ul {\n  list-style: none;\n}\n\n.sidebar-widget li {\n  margin-bottom: 10px;\n}\n\n.sidebar-widget li a {\n  color: var(--secondary-color);\n}\n\n.sidebar-widget li a:hover {\n  color: var(--accent-color);\n}\n\n/* 6. Footer */\n.blog-footer {\n  background-color: var(--primary-color);\n  color: #ffffff;\n  text-align: center;\n  padding: 30px 0;\n  font-size: 0.9rem;\n}\n\n/* 7. Responsive Layout (Mobile view) */\n@media (max-width: 768px) {\n  .main-layout {\n    grid-template-columns: 1fr;\n    gap: 30px;\n  }\n\n  .blog-title {\n    font-size: 2rem;\n  }\n}\n\n/* 8. Single Article View Specific Styles */\n.single-article-layout {\n  max-width: 800px; /* Centered, highly readable line lengths for long-form reading */\n  margin: 40px auto 60px auto;\n  padding: 0 20px;\n}\n\n.blog-content {\n  background-color: var(--card-bg);\n  padding: 40px;\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n}\n\n.article-header {\n  border-bottom: 1px solid var(--border-color);\n  padding-bottom: 20px;\n  margin-bottom: 30px;\n}\n\n.entry-title {\n  font-size: 2.5rem;\n  line-height: 1.2;\n  margin-top: 10px;\n  color: var(--primary-color);\n}\n\n/* Typography styles for the reading pane */\n.article-body p {\n  margin-bottom: 20px;\n  color: #333333;\n  font-size: 1.1rem;\n}\n\n.article-body h3 {\n  font-size: 1.5rem;\n  margin: 35px 0 15px 0;\n  color: var(--primary-color);\n}\n\n/* Blockquote Formatting */\n.article-body blockquote {\n  background-color: #f9f9f9;\n  border-left: 4px solid var(--primary-color);\n  margin: 30px 0;\n  padding: 20px 25px;\n  font-style: italic;\n  color: #444444;\n}\n\n.article-body blockquote cite {\n  display: block;\n  font-style: normal;\n  font-weight: 600;\n  font-size: 0.9rem;\n  margin-top: 10px;\n  color: var(--secondary-color);\n}\n\n/* 9. Comments Section */\n.comments-section {\n  margin-top: 50px;\n  border-top: 2px solid var(--border-color);\n  padding-top: 35px;\n}\n\n.comments-section h3 {\n  margin-bottom: 20px;\n}\n\n.comment-list {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  margin-bottom: 40px;\n}\n\n.comment-item {\n  background: #fdfdfd;\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  padding: 20px;\n}\n\n.comment-meta {\n  margin-bottom: 10px;\n  font-size: 0.9rem;\n}\n\n.comment-author {\n  font-weight: 700;\n  color: var(--primary-color);\n  margin-right: 10px;\n}\n\n.comment-date {\n  color: var(--secondary-color);\n}\n\n.comment-content p {\n  font-size: 1rem;\n  color: #444444;\n}\n\n/* 10. Comment Interactive Input Fields */\n.comment-form {\n  background-color: #f9f9f9;\n  padding: 25px;\n  border-radius: 6px;\n  border: 1px solid var(--border-color);\n}\n\n.form-group {\n  margin-bottom: 15px;\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.form-group label {\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: var(--primary-color);\n}\n\n.form-group input,\n.form-group textarea {\n  width: 100%;\n  padding: 10px;\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  font-family: inherit;\n  font-size: 1px;\n}\n\n.form-group input:focus,\n.form-group textarea:focus {\n  outline: none;\n  border-color: var(--accent-color);\n  box-shadow: 0 0 0 2px rgba(0, 102, 204, 0.1);\n}\n\n.submit-btn {\n  background-color: var(--primary-color);\n  color: #ffffff;\n  border: none;\n  padding: 12px 24px;\n  font-size: 0.95rem;\n  font-weight: 600;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: background-color 0.2s ease;\n}\n\n.submit-btn:hover {\n  background-color: var(--accent-color);\n}\n\n/* Small adjustments for screens smaller than tablet */\n@media (max-width: 600px) {\n  .blog-content {\n    padding: 20px;\n  }\n  .entry-title {\n    font-size: 2rem;\n  }\n}\n",
